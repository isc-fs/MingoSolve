{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISC MingoSolve",
  "version": "0.1.0",
  "identifier": "com.iscracingteam.mingosolve",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ISC MingoSolve",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "nsis"],
    "createUpdaterArtifacts": false,
    "category": "Education",
    "copyright": "Copyright © 2026 ISC Racing Team",
    "shortDescription": "Solve Formula Student quiz calculations fast.",
    "longDescription": "ISC MingoSolve finds the right formula for a quiz question, solves for whatever is missing with units, chains formulas, scores dynamic events under the legacy, 2026 and 2027 rules, and checks the answer against the multiple-choice options. Built on FS-Quiz data (fs-quiz.eu, ODbL).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/isc-fs/iskapps/main/mingosolve/latest.json"
      ],
      "pubkey": ""
    }
  }
}
